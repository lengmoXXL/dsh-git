# Dependencies
node_modules/

# Build outputs. A profile links this package directory and loads lib/ from
# disk, so the build stays on disk; it is rebuilt from src/ by `npm run build`
# and is not part of the source history.
lib/
*.tsbuildinfo

# The browser test's own outputs: the page it serves is built from the artifact
# by `tests/browser/page.mjs`, and the run's results are Playwright's.
tests/browser/.page/
test-results/

